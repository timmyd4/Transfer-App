# Copy this file to ".env" and fill in your own Supabase project values.
# Find these in your Supabase project: Settings -> API
# VITE_SUPABASE_ANON_KEY is the "anon" / "public" key (Supabase may label it "publishable").
# Never paste the "service_role" key here - that one must stay secret.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
